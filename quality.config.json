{
  "defaults": {
    "mutation": {
      "include": [
        "src/**/*.ts",
        "src/**/*.tsx"
      ],
      "exclude": []
    },
    "crap": {
      "exclude": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.d.ts"
      ]
    },
    "scrap": {
      "include": [
        "tests/**/*.test.ts",
        "tests/**/*.test.tsx"
      ],
      "exclude": []
    },
    "organize": {
      "lowInfoNames": {
        "banned": ["utils", "helpers", "misc", "common", "shared", "_shared", "lib", "index"],
        "discouraged": ["types", "constants", "config", "base", "core"]
      }
    },
    "boundaries": {
      "include": [
        "src/**/*.ts",
        "src/**/*.tsx"
      ],
      "exclude": [
        "src/**/*.d.ts",
        "**/*.test.ts",
        "**/*.test.tsx"
      ]
    }
  },
  "packages": {
    "quality-tools": {
      "mutation": {
        "exclude": [
          "src/cli/**/*.ts"
        ]
      },
      "boundaries": {
        "entrypoints": [
          "src/**/command.ts"
        ],
        "exclude": [
          "src/cli/**/*.ts",
          "tests/**/*.ts"
        ]
      }
    }
  }
}
